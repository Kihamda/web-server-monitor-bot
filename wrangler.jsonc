{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "discord-watch-bot",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-14",
  "durable_objects": {
    "bindings": [
      {
        "name": "MONITOR_SCHEDULER",
        "class_name": "MonitorScheduler"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["MonitorScheduler"]
    }
  ]
}
